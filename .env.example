# Server only. Never prefix secrets with NEXT_PUBLIC_.
APP_URL=http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Supabase transaction pooler URL (port 6543), URL-encode password.
DATABASE_URL=
# No external storage account required in local mode.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.runtime/storage
# Optional: fill these only when STORAGE_DRIVER=s3.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=studysort
# At least 32 random characters. HMAC for anonymous session capabilities/IP budgets.
SESSION_SECRET=
# Inngest Cloud: event key and signing key. Local dev: INNGEST_DEV=1.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1
# Set to 1 only behind Vercel's trusted forwarding headers.
TRUST_PROXY=0

# Use sqlite for local development, postgres for Vercel.
DATABASE_DRIVER=sqlite
SQLITE_PATH=.runtime/studysort.sqlite
